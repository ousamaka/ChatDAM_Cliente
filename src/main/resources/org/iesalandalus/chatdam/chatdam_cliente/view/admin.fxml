<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="320.0" prefWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.iesalandalus.chatdam.chatdam_cliente.controller.AdminController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Alta de Empleado" />
    <Label style="-fx-text-fill: #57606a;" text="Registra un nuevo usuario en la BD" />

    <VBox spacing="5.0">
        <Label style="-fx-font-weight: bold;" text="Nuevo Usuario:" />
        <TextField fx:id="txtNuevoUsuario" promptText="Ej: maria_lopez" />
    </VBox>

    <VBox spacing="5.0">
        <Label style="-fx-font-weight: bold;" text="Contraseña:" />
        <PasswordField fx:id="txtNuevaPassword" promptText="Contraseña" />
    </VBox>

    <Label fx:id="lblMensaje" visible="false" />

    <Button mnemonicParsing="false" onAction="#registrar" prefWidth="250.0" styleClass="accent" text="Registrar Empleado" />
    <Button mnemonicParsing="false" onAction="#cerrar" prefWidth="250.0" text="Cerrar Ventana" />
</VBox>