<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="500.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.iesalandalus.chatdam.chatdam_cliente.controller.ChatController">

    <MenuBar>
        <menus>
            <Menu text="Archivo">
                <items>
                    <MenuItem text="Salir" onAction="#salirAplicacion"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="lblUsuario" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Usuario" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAdmin" mnemonicParsing="false" onAction="#abrirGestionEmpleados" styleClass="danger" text="Gestión Empleados" visible="false" managed="false"/>
        </HBox>

        <TextArea fx:id="areaMensajes" editable="false" prefHeight="400.0" VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="campoTexto" onAction="#enviarMensaje" promptText="Escribe un mensaje..." HBox.hgrow="ALWAYS" />
            <Button fx:id="btnEnviar" onAction="#enviarMensaje" styleClass="success" text="Enviar" />
        </HBox>
    </VBox>
</VBox>